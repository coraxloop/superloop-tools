#!/usr/bin/env bash
# Meson substitutes the release group's manifest or ledger version.
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  printf '%s\n' '{"schema":1,"command":"steward-spool-append","kind":"version","message":"version requested","fields":{"type":"version","version":"steward-spool-append @VERSION@"}}' >&2
  exit 0
fi
# Root-side durable producer for correspondence cases.
set -euo pipefail

usage() {
  printf '%s\n' 'usage: steward-spool-append --source FOLDER --file RELATIVE --sha SHA --classification CLASS --timestamp TIME' >&2
  exit 2
}

valid_field() {
  case $1 in
    *$'\t'*|*$'\n'*|*$'\r'*) return 1 ;;
    *) return 0 ;;
  esac
}

SOURCE=
RELATIVE=
EVENT_SHA=
CLASSIFICATION=
EVENT_TIMESTAMP=
while [ "$#" -gt 0 ]; do
  case $1 in
    --source) [ "$#" -ge 2 ] || usage; SOURCE=$2; shift 2 ;;
    --file) [ "$#" -ge 2 ] || usage; RELATIVE=$2; shift 2 ;;
    --sha) [ "$#" -ge 2 ] || usage; EVENT_SHA=$2; shift 2 ;;
    --classification) [ "$#" -ge 2 ] || usage; CLASSIFICATION=$2; shift 2 ;;
    --timestamp) [ "$#" -ge 2 ] || usage; EVENT_TIMESTAMP=$2; shift 2 ;;
    *) usage ;;
  esac
done

[ -n "$SOURCE" ] || usage
[ -n "$RELATIVE" ] || usage
[ -n "$EVENT_SHA" ] || usage
[ -n "$CLASSIFICATION" ] || usage
[ -n "$EVENT_TIMESTAMP" ] || usage
for field in "$SOURCE" "$RELATIVE" "$EVENT_SHA" "$CLASSIFICATION" "$EVENT_TIMESTAMP"; do
  valid_field "$field" || {
    printf '%s\n' 'steward-spool-append: fields may not contain tabs or line breaks' >&2
    exit 2
  }
done
# Producers use whole-second UTC; validate before even opening the spool lock.
if [[ ! $EVENT_TIMESTAMP =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
   ! VALIDATED_TIMESTAMP=$(date -u -d "$EVENT_TIMESTAMP" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) ||
   [ "$VALIDATED_TIMESTAMP" != "$EVENT_TIMESTAMP" ]; then
  printf 'steward-spool-append: invalid UTC timestamp (expected YYYY-MM-DDTHH:MM:SSZ): %s\n' "$EVENT_TIMESTAMP" >&2
  exit 2
fi
case $SOURCE in
  /*) ;;
  *) printf '%s\n' 'steward-spool-append: source must be absolute' >&2; exit 2 ;;
esac
case $RELATIVE in
  /*|..|../*|*/..|*/../*)
    printf '%s\n' 'steward-spool-append: file must stay below the source folder' >&2
    exit 2
    ;;
esac
printf '%s\n' "$EVENT_SHA" | grep -Eq '^[0-9a-f]{12,64}$' || {
  printf '%s\n' 'steward-spool-append: sha must contain 12 to 64 lowercase hexadecimal digits' >&2
  exit 2
}
case $CLASSIFICATION in
  user=?*' from=user') ;;
  *)
    printf '%s\n' 'steward-spool-append: only from=user events open cases' >&2
    exit 2
    ;;
esac

EXPECTED_UID=${STEWARD_SPOOL_EXPECT_UID:-0}
CURRENT_UID=$(id -u)
if [ "$CURRENT_UID" != "$EXPECTED_UID" ]; then
  printf 'steward-spool-append: expected uid %s, found %s\n' "$EXPECTED_UID" "$CURRENT_UID" >&2
  exit 1
fi

SPOOL=${STEWARD_SPOOL_FILE:-/var/lib/steward/spool/cases.tsv}
LOCK=${STEWARD_SPOOL_LOCK_FILE:-${SPOOL}.lock}
umask 027
[ -f "$SPOOL" ] && [ ! -L "$SPOOL" ] && [ -w "$SPOOL" ] || {
  printf 'steward-spool-append: spool is not a writable regular file: %s\n' "$SPOOL" >&2
  exit 1
}
SPOOL_UID=$(stat -c %u -- "$SPOOL")
if [ "$SPOOL_UID" != "$EXPECTED_UID" ]; then
  printf 'steward-spool-append: spool must be owned by uid %s, found %s\n' "$EXPECTED_UID" "$SPOOL_UID" >&2
  exit 1
fi

CASE_ID=case-$(printf '%s\0%s\0%s\0%s' "$SOURCE" "$RELATIVE" "$EVENT_SHA" "$CLASSIFICATION" | sha256sum | cut -d ' ' -f 1)
exec 9>>"$LOCK"
flock -x 9
if awk -F '\t' -v case_id="$CASE_ID" '$1 == case_id { found = 1 } END { exit !found }' "$SPOOL"; then
  printf 'STEWARD-SPOOL-UNCHANGED case=%s\n' "$CASE_ID"
  exit 0
fi

printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$CASE_ID" "$SOURCE" "$RELATIVE" "$EVENT_SHA" "$CLASSIFICATION" "$EVENT_TIMESTAMP" >> "$SPOOL"
sync -d "$SPOOL"
sync -f "$(dirname -- "$SPOOL")"
printf 'STEWARD-SPOOL-APPENDED case=%s\n' "$CASE_ID"
