pkg_superloop_runtime_rust = files('src/main.rs', 'src/runtime.rs', 'tests/subprocess_contract.rs')
pkg_superloop_runtime_prose = files('README.md')
pkg_superloop_runtime_toml = []
pkg_superloop_runtime_install = files('src/watchdog.sh', 'src/prepare.sh')

pkg_superloop_runtime_excluded_rust = []

pkg_superloop_runtime_excluded_prose = []

pkg_superloop_runtime_excluded_toml = []

pkg_superloop_runtime_sync_outputs = []

pkg_superloop_runtime_sync_superloop_runtime = custom_target(
  'sync-superloop-runtime',
  output: ['superloop-runtime', 'superloop-runtime.build.json'],
  input: workspace_build,
  command: [find_program('env'), workspace_sync, '--artifact', meson.project_build_root() / 'cargo-superloop-runtime', build_identity_args, '--domain', domain, cargo.full_path(), root_manifest, 'superloop-runtime', 'superloop-runtime', '@OUTPUT0@'],
  build_by_default: true,
  install: true,
  install_dir: [get_option('bindir'), get_option('datadir') / 'superloop' / 'build-records'],
)
pkg_superloop_runtime_sync_outputs += pkg_superloop_runtime_sync_superloop_runtime





dependency_ledger += ['''
