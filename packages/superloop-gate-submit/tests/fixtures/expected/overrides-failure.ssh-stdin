set -e; . /srv/example/env/rust.sh; cd /srv/example/worktree
git fetch -q origin '+refs/lanes/verify-named:refs/lanes/verify-named'
git checkout -qf --detach refs/lanes/verify-named && git clean -qfdx
echo '== fmt =='; time nice -n19 cargo fmt --all -- --check
echo '== clippy =='; time nice -n19 cargo clippy --workspace --all-targets --locked -- -D warnings
echo '== test =='; time nice -n19 cargo test  -p alpha --all-features --locked
echo '== doc =='; time nice -n19 env RUSTDOCFLAGS='-D warnings' cargo doc --no-deps  -p alpha --locked
