set -e; . /srv/orchestration-pack/env/rust.sh; cd /srv/orchestration-pack/worktree
git fetch -q origin '+refs/lanes/verify-worktree:refs/lanes/verify-worktree'
git checkout -qf --detach refs/lanes/verify-worktree && git clean -qfdx
# superloop-gate-submit probe token=PROBE_TOKEN
checked_out=$(git rev-parse HEAD); checked_status=$(git status --porcelain --untracked-files=normal); trap 'status=$?; final_head=$(git rev-parse HEAD 2>/dev/null) || final_head=missing; final_status=$(git status --porcelain --untracked-files=normal 2>/dev/null) || final_status=unreadable; if [ "$final_head" != "$checked_out" ] || [ "$final_status" != "$checked_status" ] || [ -n "$final_status" ]; then printf "CHECKED-OUT-DRIFT token=%s\n" "PROBE_TOKEN"; if [ "$status" -eq 0 ]; then status=1; fi; fi; printf "CHECKED-OUT object=%s ref=%s token=%s\n" "$final_head" "refs/heads/lane/R" "PROBE_TOKEN"; exit "$status"' EXIT
echo '== fmt =='; time nice -n19 cargo fmt --all -- --check
echo '== clippy =='; time nice -n19 cargo clippy --workspace --all-targets --locked -- -D warnings
echo '== test =='; time nice -n19 cargo test  -p alpha -p beta  --locked

