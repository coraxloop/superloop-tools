pkg_superloop_lane_sync_superloop_lane = custom_target(
  'sync-superloop-lane',
  output: ['superloop-lane', 'superloop-lane.build.json'],
  input: workspace_build,
  command: [find_program('env'), workspace_sync, '--artifact', meson.project_build_root() / 'cargo-superloop-lane', build_identity_args, '--domain', domain, cargo.full_path(), root_manifest, 'superloop-lane', 'superloop-lane', '@OUTPUT0@'],
  build_by_default: true,
  install: true,
  install_dir: [get_option('bindir'), get_option('datadir') / 'superloop' / 'build-records'],
)
pkg_superloop_lane_sync_outputs += pkg_superloop_lane_sync_superloop_lane

pkg_superloop_lane_sync_proxy = custom_target(
  'sync-superloop-lane-vendor-proxy',
  output: ['vendor-proxy', 'vendor-proxy.build.json'],
  input: workspace_build,
  command: [find_program('env'), workspace_sync, '--artifact', meson.project_build_root() / 'cargo-superloop-lane-vendor-proxy', build_identity_args, '--domain', domain, cargo.full_path(), root_manifest, 'superloop-lane', 'superloop-lane-vendor-proxy', '@OUTPUT0@'],
  build_by_default: true,
  install: true,
  install_dir: [get_option('libexecdir') / 'superloop', get_option('datadir') / 'superloop' / 'build-records'],
)
pkg_superloop_lane_sync_outputs += pkg_superloop_lane_sync_proxy

