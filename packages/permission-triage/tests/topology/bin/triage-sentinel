#!/bin/sh
set -eu

[ "$#" -eq 1 ]
[ "$1" = "TRIAGE_AUTO_SENTINEL" ]
fixture_root=${PERMISSION_TRIAGE_FIXTURE_ROOT:?}
state_root=${PERMISSION_TRIAGE_STATE_ROOT:?}
[ "$state_root" = "$fixture_root/state" ]
temporary="$state_root/ran.$$"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
umask 077
printf '%s\n' TRIAGE_AUTO_SENTINEL > "$temporary"
mv "$temporary" "$state_root/ran"
trap - EXIT HUP INT TERM
